{
  "name": "@design-theory/toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first tools for brief-driven typography, color, composition, motion and material relationships.",
  "bin": {
    "design": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "design": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "npm run build && tsx --test test/browser.integration.ts",
    "test:native": "npm run build && tsx --test test/native.integration.ts",
    "typecheck": "tsc --noEmit",
    "spike": "npm run build && tsx scripts/spike.ts",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check": "npm run verify",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all",
    "native:provision": "sh scripts/provision-native.sh",
    "native:start": "node scripts/native-session.mjs",
    "selector:provision": "sh scripts/provision-selector.sh",
    "selector:smoke": "DESIGN_SEMIF_BIN=./scripts/semif-local.sh node scripts/selector-smoke.mjs",
    "evaluate:agent": "DESIGN_SEMIF_BIN=./scripts/semif-local.sh node scripts/evaluate-agent.mjs",
    "evaluate:ratings": "node scripts/prepare-ratings.mjs artifacts/evaluation-v2",
    "selector:provision:tiny": "sh scripts/provision-tiny-selector.sh",
    "selector:probe": "DESIGN_SEMIF_BIN=./scripts/semif-local.sh DESIGN_PROBE_READOUT=balanced node scripts/probe-selector.mjs",
    "tuning:specimens": "node scripts/tuning-specimens.mjs",
    "context:budget": "node scripts/context-budget.mjs",
    "evidence:export": "node scripts/export-evidence.mjs",
    "fieldwork:build": "npm run build && node scripts/build-fieldwork.mjs",
    "fieldwork:web:proof": "node scripts/prove-fieldwork-web.mjs",
    "fieldwork:native": "node scripts/native-session.mjs --fieldwork",
    "fieldwork:native:flows": "node scripts/fieldwork-native-flows.mjs",
    "vela:design": "tsx scripts/vela-design.ts",
    "vela:build": "npm run build && npm run vela:design && node scripts/build-vela.mjs",
    "vela:web:proof": "node scripts/prove-vela-web.mjs",
    "vela:native": "node scripts/native-session.mjs --vela",
    "vela:native:flows": "node scripts/vela-native-flows.mjs",
    "design:machine:proof": "node scripts/prove-design-machine.mjs",
    "workflow:proof": "node scripts/prove-decision-workflow.mjs",
    "gallery:build": "npm run build && node scripts/build-design-theory.mjs",
    "gallery:proof": "node scripts/prove-design-theory.mjs",
    "vela:motion:proof": "node scripts/prove-vela-motion.mjs",
    "validation:proof": "npm run build && node scripts/prove-validation-machine.mjs",
    "evidence:extension": "node scripts/export-design-theory-evidence.mjs",
    "typography:proof": "npm run build && node scripts/prove-typography.mjs",
    "test:migrations": "node codemods/2026-10-25-nullable-glyph-ink/test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/stylex": "0.19.1",
    "colorjs.io": "0.7.1",
    "esbuild": "0.25.12",
    "fontkit": "2.0.4",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "playwright": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
