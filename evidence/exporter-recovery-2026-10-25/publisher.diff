+// Recovery-only projection matches selector.ts SemifResult.model.gguf parsing.
+// Location/size metadata is preserved in the raw file; content identity is sha256.
+export function functionalModelProvenance(model) {
+  assert.ok(model && typeof model === 'object' && !Array.isArray(model));
+  assert.ok(model.gguf && typeof model.gguf === 'object' && !Array.isArray(model.gguf));
+  assert.match(model.gguf.sha256, /^[a-f0-9]{64}$/);
+  return { ...model, gguf: { sha256: model.gguf.sha256 } };
+}
+export function assertFunctionalModelProvenance(raw, curated) {
+  assert.deepEqual(functionalModelProvenance(raw), functionalModelProvenance(curated));
+}
